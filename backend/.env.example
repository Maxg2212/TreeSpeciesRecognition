# SQLite for local dev/demo. Swap to a postgresql:// URL + provider = "postgresql"
# in prisma/schema.prisma to move to PostgreSQL later, no other code changes needed.
DATABASE_URL="file:./dev.db"

PORT=3001

# Google Maps Static API. Requires a Google Cloud project with billing
# enabled (a card on file is required even within the free allowance) and
# the Maps Static API enabled: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Zoom level for the canopy crop (Google Static Maps uses center+zoom, not a
# bbox). ~20 frames roughly a single tree's canopy; higher = tighter crop.
CANOPY_ZOOM=20
