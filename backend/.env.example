# SQLite for local dev/demo. Swap to a postgresql:// URL + provider = "postgresql"
# in prisma/schema.prisma to move to PostgreSQL later, no other code changes needed.
DATABASE_URL="file:./dev.db"

PORT=3001

# Degrees of lat/lon spanned by the cropped canopy image (roughly proportional
# to real-world width; smaller = tighter zoom on the tree canopy).
CANOPY_BBOX_DEGREES=0.0015

# Esri ArcGIS World Imagery export endpoint. No auth required for basic use.
ESRI_WORLD_IMAGERY_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/export"
