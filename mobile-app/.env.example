# Base URL of the backend. Must be HTTPS and must NOT be "localhost" — this
# app is served over HTTPS (required for geolocation), so a plain-HTTP
# backend gets silently blocked as mixed content, and on a phone
# "localhost" means the phone itself, not your computer. Use the
# computer's LAN IP, e.g. https://192.168.1.23:3001 (find it with
# `ifconfig`/`ip addr`; the backend's cert already covers it — see
# backend/README.md).
VITE_API_URL=https://localhost:3001
